<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Kearsipan - BBWS Cimanuk Cisanggarung | Kementerian PU</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="style.css">
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased flex h-screen overflow-hidden">

  <!-- SIDEBAR NAVIGATION -->
  <aside class="w-64 bg-slate-900 text-slate-200 flex flex-col justify-between shadow-xl flex-shrink-0 z-20">
    <div>
      <!-- Logo & Header Instansi -->
      <div class="px-5 py-4 border-b border-slate-800 flex items-center gap-3">
        <img src="logo-pu.webp" alt="Logo PU" class="w-9 h-9 object-contain" onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Logo_PU_%28Kementerian_Pekerjaan_Umum%29.png/120px-Logo_PU_%28Kementerian_Pekerjaan_Umum%29.png'">
        <div>
          <h1 class="text-xs font-bold tracking-wider uppercase text-yellow-400 leading-tight">Kementerian PU</h1>
          <p class="text-[10px] text-slate-400 font-medium">BBWS Cimanuk Cisanggarung</p>
        </div>
      </div>

      <div class="px-5 py-3 border-b border-slate-800/60 bg-slate-950/40">
        <h2 class="text-sm font-semibold text-white tracking-wide">Dashboard Kearsipan</h2>
        <p class="text-[11px] text-blue-400">KPI & Stok Pengelolaan Arsip</p>
      </div>

      <!-- Navigation Links -->
      <nav class="mt-3 px-3 space-y-1 text-sm font-medium">
        <button onclick="switchTab('beranda')" id="nav-beranda" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-white bg-blue-600 transition-all shadow-sm">
          <i class="fa-solid fa-house w-4 text-center"></i>
          <span>Beranda</span>
        </button>

        <button onclick="switchTab('kpi')" id="nav-kpi" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-all">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-chart-column w-4 text-center text-emerald-400"></i>
            <span>KPI Kearsipan</span>
          </div>
          <span class="text-[10px] bg-slate-800 px-1.5 py-0.5 rounded text-emerald-300 font-mono">10 Indikator</span>
        </button>

        <button onclick="switchTab('stok')" id="nav-stok" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-all">
          <i class="fa-solid fa-boxes-stacked w-4 text-center text-amber-400"></i>
          <span>Stok Pengelolaan Arsip</span>
        </button>

        <button onclick="switchTab('musnah')" id="nav-musnah" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-all">
          <i class="fa-solid fa-calendar-xmark w-4 text-center text-purple-400"></i>
          <span>Rencana Pemusnahan</span>
        </button>

        <button onclick="switchTab('input-data')" id="nav-input-data" class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-all">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-pen-to-square w-4 text-center text-cyan-400"></i>
            <span>Input / Update Data</span>
          </div>
          <span class="text-[10px] bg-blue-900/60 text-blue-300 px-1.5 py-0.5 rounded border border-blue-700/50">Petugas</span>
        </button>

        <button onclick="switchTab('laporan')" id="nav-laporan" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-all">
          <i class="fa-solid fa-file-export w-4 text-center text-teal-400"></i>
          <span>Laporan & Tindak Lanjut</span>
        </button>
      </nav>
    </div>

    <!-- Bottom Sidebar Section -->
    <div class="p-3 border-t border-slate-800 space-y-2">
      <button onclick="switchTab('database')" id="nav-database" class="nav-item w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs text-slate-400 hover:text-white hover:bg-slate-800 transition-all">
        <i class="fa-solid fa-table-cells text-emerald-400"></i>
        <span>Database Pusat (Sheets)</span>
      </button>

      <button onclick="openModal('modalSettings')" class="w-full flex items-center gap-3 px-3.5 py-2 rounded-lg text-xs text-slate-400 hover:text-white hover:bg-slate-800 transition-all">
        <i class="fa-solid fa-gear text-slate-400"></i>
        <span>Pengaturan Sistem</span>
      </button>

      <div class="pt-2 border-t border-slate-800/80 flex items-center gap-2.5 px-2">
        <div class="w-8 h-8 rounded-full bg-blue-600/30 border border-blue-500/40 flex items-center justify-center text-blue-300 font-bold text-xs">
          AD
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-slate-200 truncate" id="userRoleName">Admin Kearsipan</p>
          <p class="text-[10px] text-emerald-400 truncate flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span> Terhubung Pusat
          </p>
        </div>
      </div>
    </div>
  </aside>

  <!-- MAIN VIEWPORT -->
  <div class="flex-1 flex flex-col overflow-hidden">
    
    <!-- TOP NAVBAR -->
    <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between shadow-sm z-10 flex-shrink-0">
      <div class="flex items-center gap-4">
        <div>
          <div class="flex items-center gap-2">
            <h2 id="topBarTitle" class="text-base font-bold text-slate-800">Logger Studio - Capaian KPI Kearsipan</h2>
            <span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-medium border border-blue-200">BBWS Cimanuk Cisanggarung</span>
          </div>
          <p class="text-xs text-slate-500">Periode Aktif: <span class="font-medium text-slate-700" id="currentPeriodLabel">Tahun 2026</span> (1 Januari 2026 – 31 Desember 2026)</p>
        </div>
      </div>

      <!-- Filter Controls & Profile -->
      <div class="flex items-center gap-3">
        <!-- Filter Periode -->
        <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1 text-xs text-slate-700">
          <i class="fa-regular fa-calendar text-slate-400 mr-2"></i>
          <span class="text-slate-400 mr-1.5">Periode:</span>
          <select id="filterPeriode" onchange="applyFilters()" class="bg-transparent font-semibold text-slate-800 focus:outline-none cursor-pointer">
            <option value="2026">Tahun 2026</option>
            <option value="2025">Tahun 2025</option>
          </select>
        </div>

        <!-- Filter Gedung Arsip -->
        <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1 text-xs text-slate-700">
          <i class="fa-solid fa-building text-slate-400 mr-2"></i>
          <span class="text-slate-400 mr-1.5">Gedung Arsip:</span>
          <select id="filterGedung" onchange="applyFilters()" class="bg-transparent font-semibold text-slate-800 focus:outline-none cursor-pointer">
            <option value="SEMUA">Semua Gedung</option>
            <option value="Pusat">Gedung Arsip Pusat</option>
            <option value="Barat">Gedung Arsip Barat</option>
            <option value="Timur">Gedung Arsip Timur</option>
            <option value="Selatan">Gedung Arsip Selatan</option>
            <option value="Utara">Gedung Arsip Utara</option>
          </select>
        </div>

        <!-- Tombol Tambah Data Cepat -->
        <button onclick="switchTab('input-data')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-medium flex items-center gap-1.5 transition shadow-sm">
          <i class="fa-solid fa-plus text-[10px]"></i>
          <span>Input Data</span>
        </button>

        <!-- Tombol Putar Ulang Animasi -->
        <button onclick="replayChartAnimations()" title="Putar ulang animasi diagram" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium flex items-center gap-1.5 transition border border-slate-300">
          <i class="fa-solid fa-play text-blue-600 text-[10px]"></i>
          <span class="hidden md:inline">Animasi</span>
        </button>

        <!-- Profile badge -->
        <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
          <div class="w-8 h-8 rounded-full bg-slate-800 text-yellow-400 font-bold text-xs flex items-center justify-center">
            <i class="fa-solid fa-user-shield text-xs"></i>
          </div>
          <div class="text-left hidden sm:block">
            <div class="text-xs font-bold text-slate-800 leading-tight">admin</div>
            <div class="text-[10px] text-slate-500">Petugas Kearsipan</div>
          </div>
        </div>
      </div>
    </header>

    <!-- CONTENT BODY (SCROLLABLE) -->
    <main class="flex-1 overflow-y-auto p-6 space-y-6 bg-slate-100" id="mainContainer">

      <!-- ================= TAB 1: BERANDA ================= -->
      <section id="tab-beranda" class="tab-content block space-y-6">
        
        <!-- ROW 1: 4 KARTU KPI UTAMA -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Card 1: KPI Arsip Aktif -->
          <div class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-sm hover:shadow transition relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-blue-500"></div>
            <div class="flex justify-between items-start mb-2">
              <span class="text-xs font-semibold text-slate-500">KPI Arsip Aktif</span>
              <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                <i class="fa-regular fa-folder-open text-sm"></i>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-extrabold text-slate-800" id="kpiAktifVal">92%</span>
              <span class="text-xs font-semibold text-emerald-600 flex items-center gap-0.5">
                <i class="fa-solid fa-arrow-up text-[10px]"></i> 2% <span class="text-slate-400 font-normal">vs bln lalu</span>
              </span>
            </div>
            <div class="mt-2 text-xs text-slate-500 flex justify-between items-center pt-2 border-t border-slate-100">
              <span>Target: <strong class="text-slate-700">&ge; 95%</strong></span>
              <span class="text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded text-[10px] font-semibold">Tercapai Baik</span>
            </div>
          </div>

          <!-- Card 2: KPI Arsip Inaktif -->
          <div class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-sm hover:shadow transition relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-emerald-500"></div>
            <div class="flex justify-between items-start mb-2">
              <span class="text-xs font-semibold text-slate-500">KPI Arsip Inaktif</span>
              <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fa-regular fa-file-lines text-sm"></i>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-extrabold text-slate-800" id="kpiInaktifVal">88%</span>
              <span class="text-xs font-semibold text-emerald-600 flex items-center gap-0.5">
                <i class="fa-solid fa-arrow-up text-[10px]"></i> 3% <span class="text-slate-400 font-normal">vs bln lalu</span>
              </span>
            </div>
            <div class="mt-2 text-xs text-slate-500 flex justify-between items-center pt-2 border-t border-slate-100">
              <span>Target: <strong class="text-slate-700">&ge; 90%</strong></span>
              <span class="text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded text-[10px] font-semibold">Mendekati Target</span>
            </div>
          </div>

          <!-- Card 3: KPI Layanan Peminjaman -->
          <div class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-sm hover:shadow transition relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-amber-500"></div>
            <div class="flex justify-between items-start mb-2">
              <span class="text-xs font-semibold text-slate-500">KPI Layanan Peminjaman</span>
              <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                <i class="fa-regular fa-clock text-sm"></i>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-extrabold text-slate-800" id="kpiPinjamVal">96%</span>
              <span class="text-xs font-semibold text-emerald-600 flex items-center gap-0.5">
                <i class="fa-solid fa-arrow-up text-[10px]"></i> 1% <span class="text-slate-400 font-normal">vs bln lalu</span>
              </span>
            </div>
            <div class="mt-2 text-xs text-slate-500 flex justify-between items-center pt-2 border-t border-slate-100">
              <span>Target: <strong class="text-slate-700">&ge; 95%</strong></span>
              <span class="text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded text-[10px] font-semibold">Melampaui Target</span>
            </div>
          </div>

          <!-- Card 4: KPI Pengelolaan Arsip -->
          <div class="bg-white rounded-xl border border-slate-200/80 p-4 shadow-sm hover:shadow transition relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-purple-500"></div>
            <div class="flex justify-between items-start mb-2">
              <span class="text-xs font-semibold text-slate-500">KPI Pengelolaan Arsip</span>
              <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
                <i class="fa-solid fa-list-check text-sm"></i>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-extrabold text-slate-800" id="kpiKelolaVal">90%</span>
              <span class="text-xs font-semibold text-emerald-600 flex items-center gap-0.5">
                <i class="fa-solid fa-arrow-up text-[10px]"></i> 2% <span class="text-slate-400 font-normal">vs bln lalu</span>
              </span>
            </div>
            <div class="mt-2 text-xs text-slate-500 flex justify-between items-center pt-2 border-t border-slate-100">
              <span>Target: <strong class="text-slate-700">&ge; 90%</strong></span>
              <span class="text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded text-[10px] font-semibold">Sesuai Target</span>
            </div>
          </div>
        </div>

        <!-- ROW 2: TREN GRAFIK KPI + REKAP GEDUNG + RINGKASAN STOK & PEMUSNAHAN -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          <!-- Kolom Kiri: Tren Capaian KPI (8 Kolom) -->
          <div class="lg:col-span-8 space-y-6">
            
            <!-- Box Grafik Tren KPI Bulanan -->
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
              <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-100">
                <div>
                  <h3 class="text-sm font-bold text-slate-800">Tren Capaian KPI Kearsipan (Periode 1 Tahun)</h3>
                  <p class="text-xs text-slate-500">Fluktuasi capaian 4 indikator utama dari Januari - Desember 2026</p>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 text-[11px] text-blue-700 font-medium bg-blue-50 px-2 py-0.5 rounded border border-blue-200">
                    <span class="w-2 h-2 rounded-full bg-blue-600 inline-block"></span> Arsip Aktif
                  </span>
                  <span class="inline-flex items-center gap-1 text-[11px] text-emerald-700 font-medium bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                    <span class="w-2 h-2 rounded-full bg-emerald-600 inline-block"></span> Inaktif
                  </span>
                  <span class="inline-flex items-center gap-1 text-[11px] text-amber-700 font-medium bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                    <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span> Peminjaman
                  </span>
                </div>
              </div>
              <div class="h-64 relative">
                <canvas id="trendKPIChart"></canvas>
              </div>
            </div>

            <!-- Tabel Rekap Capaian KPI per Gedung Arsip -->
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
              <div class="flex justify-between items-center mb-3">
                <h3 class="text-sm font-bold text-slate-800">Rekap Capaian KPI per Gedung Arsip</h3>
                <span class="text-xs text-slate-500">Rata-rata kumulatif tahun berjalan</span>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-xs text-left">
                  <thead class="bg-slate-50 text-slate-600 uppercase border-y border-slate-200">
                    <tr>
                      <th class="py-2.5 px-3">Gedung Arsip</th>
                      <th class="py-2.5 px-3 text-center">Aktif (%)</th>
                      <th class="py-2.5 px-3 text-center">Inaktif (%)</th>
                      <th class="py-2.5 px-3 text-center">Peminjaman (%)</th>
                      <th class="py-2.5 px-3 text-center">Pengelolaan (%)</th>
                      <th class="py-2.5 px-3 text-center">Status</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 font-medium" id="rekapGedungTableBody">
                    <!-- Dynamic Rows populated by JS -->
                  </tbody>
                </table>
              </div>
            </div>

          </div>

          <!-- Kolom Kanan: Stok Arsip & Rencana Musnah (4 Kolom) -->
          <div class="lg:col-span-4 space-y-6">
            
            <!-- Box Ringkasan Stok Pengelolaan Arsip di Gedung -->
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
              <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-warehouse text-blue-600"></i>
                  <h3 class="text-sm font-bold text-slate-800">Stok Pengelolaan Arsip</h3>
                </div>
                <button onclick="switchTab('stok')" class="text-xs text-blue-600 hover:underline">Detail &rarr;</button>
              </div>

              <div class="flex items-center gap-4 mb-4">
                <div class="w-14 h-14 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-700 text-2xl">
                  <i class="fa-solid fa-boxes-packing"></i>
                </div>
                <div>
                  <div class="text-2xl font-extrabold text-slate-800" id="totalStokLabel">12.450</div>
                  <div class="text-xs text-slate-500">Total Box / Folder Tersimpan</div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 text-center pt-2 border-t border-slate-100">
                <div class="p-2 bg-blue-50/60 rounded-lg border border-blue-100">
                  <span class="text-[10px] text-blue-600 font-medium block">Arsip Aktif</span>
                  <span class="text-sm font-bold text-slate-800" id="stokAktifVal">6.230</span>
                  <span class="text-[9px] text-slate-400 block font-medium">50%</span>
                </div>
                <div class="p-2 bg-emerald-50/60 rounded-lg border border-emerald-100">
                  <span class="text-[10px] text-emerald-600 font-medium block">Arsip Inaktif</span>
                  <span class="text-sm font-bold text-slate-800" id="stokInaktifVal">5.120</span>
                  <span class="text-[9px] text-slate-400 block font-medium">41%</span>
                </div>
                <div class="p-2 bg-amber-50/60 rounded-lg border border-amber-100">
                  <span class="text-[10px] text-amber-600 font-medium block">Arsip Vital</span>
                  <span class="text-sm font-bold text-slate-800" id="stokVitalVal">1.100</span>
                  <span class="text-[9px] text-slate-400 block font-medium">9%</span>
                </div>
              </div>

              <!-- Mini Donut Chart -->
              <div class="mt-4 pt-3 border-t border-slate-100">
                <div class="text-xs font-semibold text-slate-700 mb-2">Komposisi Stok Arsip</div>
                <div class="h-40 relative flex justify-center">
                  <canvas id="komposisiStokChart"></canvas>
                </div>
              </div>
            </div>

            <!-- Box Rencana Pemusnahan Arsip -->
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
              <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-trash-can text-red-500"></i>
                  <h3 class="text-sm font-bold text-slate-800">Rencana Pemusnahan</h3>
                </div>
                <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">Tahun 2026</span>
              </div>

              <div class="flex items-center justify-between bg-slate-50 p-3 rounded-lg border border-slate-200/80 mb-3">
                <div>
                  <span class="text-[11px] text-slate-500 block">Bulan Rencana Aktif</span>
                  <select id="selectBulanMusnahQuick" onchange="updateQuickMusnah()" class="text-xs font-bold text-slate-800 bg-transparent focus:outline-none">
                    <option value="Oktober">Oktober 2026</option>
                    <option value="November">November 2026</option>
                    <option value="Desember">Desember 2026</option>
                  </select>
                </div>
                <button onclick="switchTab('musnah')" class="px-2.5 py-1 bg-teal-600 hover:bg-teal-700 text-white rounded text-xs font-medium transition shadow-sm">
                  Lihat Detail
                </button>
              </div>

              <div class="mb-3">
                <div class="text-xs text-slate-500">Jumlah Arsip yang Akan Dimusnahkan</div>
                <div class="text-2xl font-extrabold text-red-600 mt-0.5" id="quickMusnahVolume">2.350 <span class="text-xs font-normal text-slate-500">Box/Folder</span></div>
              </div>

              <!-- Rincian Berdasarkan Jenis -->
              <div class="space-y-1.5 text-xs text-slate-600 border-t border-slate-100 pt-3">
                <div class="flex justify-between items-center">
                  <span>Arsip Dinamis</span>
                  <strong class="text-slate-800">1.200</strong>
                </div>
                <div class="flex justify-between items-center">
                  <span>Arsip Kepegawaian</span>
                  <strong class="text-slate-800">850</strong>
                </div>
