                <i class="fa-solid fa-file-excel"></i> Unduh Format Excel
              </button>
            </div>
          </div>

          <!-- Status Kepatuhan Gedung -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl">
              <div class="text-xs font-semibold text-emerald-800">Gedung Sudah Update (Bulan Ini)</div>
              <div class="text-2xl font-bold text-emerald-900 mt-1">4 dari 5 Gedung</div>
              <div class="text-[11px] text-emerald-700 mt-1">80% Kepatuhan pelaporan tepat waktu</div>
            </div>
            <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl">
              <div class="text-xs font-semibold text-rose-800">Gedung Belum / Terlambat Update</div>
              <div class="text-2xl font-bold text-rose-900 mt-1">1 Gedung (Gedung Selatan)</div>
              <div class="text-[11px] text-rose-700 mt-1">Perlu pengingat tindak lanjut</div>
            </div>
            <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl">
              <div class="text-xs font-semibold text-blue-800">Status Validasi Dokumen Pendukung</div>
              <div class="text-2xl font-bold text-blue-900 mt-1">100% Terverifikasi</div>
              <div class="text-[11px] text-blue-700 mt-1">Seluruh berkas bukti link Google Drive valid</div>
            </div>
          </div>

          <!-- Lembar Evaluasi -->
          <div class="p-5 border border-slate-200 rounded-xl bg-slate-50/50 space-y-3">
            <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Catatan Evaluasi Pimpinan & Rekomendasi Kerja</h4>
            <div class="space-y-2 text-xs text-slate-700">
              <div class="p-3 bg-white rounded border border-slate-200 flex items-start gap-2.5">
                <i class="fa-solid fa-circle-check text-emerald-600 mt-0.5"></i>
                <div>
                  <strong class="text-slate-800">Capaian Layanan Peminjaman:</strong> Melampaui target standar nasional kearsipan (rata-rata 96% vs target &ge;95%). Pertahankan SOP pengembalian maksimal 3 hari kerja.
                </div>
              </div>
              <div class="p-3 bg-white rounded border border-slate-200 flex items-start gap-2.5">
                <i class="fa-solid fa-circle-exclamation text-amber-500 mt-0.5"></i>
                <div>
                  <strong class="text-slate-800">Percepatan Pemusnahan Arsip Retensi:</strong> Volume 2.350 box pada bulan Oktober telah siap berita acara. Dimohon panitia pemusnahan segera menjadwalkan saksi hukum dan inspektorat.
                </div>
              </div>
              <div class="p-3 bg-white rounded border border-slate-200 flex items-start gap-2.5">
                <i class="fa-solid fa-clock-rotate-left text-blue-600 mt-0.5"></i>
                <div>
                  <strong class="text-slate-800">Pengingat Gedung Arsip Selatan:</strong> Petugas gedung arsip selatan dihimbau menyelesaikan input realisasi fisik sebelum tanggal 20 setiap bulan.
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= TAB 7: DATABASE PUSAT (GOOGLE SHEETS SIMULATION) ================= -->
      <section id="tab-database" class="tab-content hidden space-y-6">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 pb-3 border-b border-slate-200">
            <div>
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-file-excel text-emerald-600 text-lg"></i>
                <h3 class="text-base font-bold text-slate-800">Struktur Database Pusat (Google Sheets Hub)</h3>
              </div>
              <p class="text-xs text-slate-500">Representasi 5 tabel utama Google Sheets sesuai desain format database</p>
            </div>
            <!-- Sub Tab Tabs Database -->
            <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-lg text-xs" id="dbTabButtons">
              <button onclick="switchDbTable('MASTER_GEDUNG')" class="db-tab-btn px-2.5 py-1 rounded font-medium bg-white text-slate-800 shadow-sm" id="btn-db-MASTER_GEDUNG">MASTER_GEDUNG</button>
              <button onclick="switchDbTable('MASTER_KPI')" class="db-tab-btn px-2.5 py-1 rounded font-medium text-slate-600 hover:text-slate-900" id="btn-db-MASTER_KPI">MASTER_KPI</button>
              <button onclick="switchDbTable('INPUT_KPI')" class="db-tab-btn px-2.5 py-1 rounded font-medium text-slate-600 hover:text-slate-900" id="btn-db-INPUT_KPI">INPUT_KPI</button>
              <button onclick="switchDbTable('STOK_ARSIP')" class="db-tab-btn px-2.5 py-1 rounded font-medium text-slate-600 hover:text-slate-900" id="btn-db-STOK_ARSIP">STOK_ARSIP</button>
              <button onclick="switchDbTable('RENCANA_MUSNAH')" class="db-tab-btn px-2.5 py-1 rounded font-medium text-slate-600 hover:text-slate-900" id="btn-db-RENCANA_MUSNAH">RENCANA_MUSNAH</button>
            </div>
          </div>

          <!-- Dynamic DB View -->
          <div class="overflow-x-auto rounded-lg border border-slate-200 max-h-96">
            <table class="w-full text-xs text-left" id="tableDatabaseView">
              <!-- Rendered by JS -->
            </table>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- MODAL PENGATURAN -->
  <div id="modalSettings" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-5 space-y-4">
      <div class="flex justify-between items-center border-b border-slate-200 pb-3">
        <h4 class="text-sm font-bold text-slate-800 flex items-center gap-2">
          <i class="fa-solid fa-sliders text-blue-600"></i> Pengaturan Konektor & Sinkronisasi
        </h4>
        <button onclick="closeModal('modalSettings')" class="text-slate-400 hover:text-slate-600">&times;</button>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">URL Google Sheets Spreadsheet</label>
          <input type="text" value="https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdB.../edit" class="w-full p-2 border border-slate-300 rounded bg-slate-50 text-slate-600" readonly>
          <p class="text-[10px] text-slate-400 mt-1">Tersambung via Webhook & Looker Studio API</p>
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Frekuensi Auto-Refresh Dashboard</label>
          <select class="w-full p-2 border border-slate-300 rounded">
            <option>Realtime (Saat ada pembaruan sheet)</option>
            <option>Setiap 15 Menit</option>
            <option>Setiap Hari</option>
          </select>
        </div>
        <div class="p-3 bg-blue-50 border border-blue-200 rounded-lg text-blue-800 text-[11px]">
          <strong>Info:</strong> Seluruh data di aplikasi ini tersimpan di memori browser (LocalStorage) dan siap dihubungkan langsung ke Google Apps Script / Sheet ID Anda.
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
        <button onclick="closeModal('modalSettings')" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded text-xs">Tutup</button>
        <button onclick="resetDataDefault()" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded text-xs">Reset ke Data Awal</button>
      </div>
    </div>
  </div>

  <!-- SCRIPT UTAMA -->
  <script src="app.js"></script>
</body>
</html>
