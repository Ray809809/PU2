      <!-- ================= TAB 5: INPUT / UPDATE DATA (FORM PETUGAS) ================= -->
      <section id="tab-input-data" class="tab-content hidden space-y-6">
        <div class="max-w-4xl mx-auto bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3 pb-4 border-b border-slate-200 mb-6">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
              <i class="fa-solid fa-pen-nib"></i>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-800">Form Pengisian Data Kearsipan Bulanan</h3>
              <p class="text-xs text-slate-500">Petugas gedung arsip wajib melengkapi data capaian dan bukti pendukung</p>
            </div>
          </div>

          <form id="formInputPetugas" onsubmit="handleFormInput(event)" class="space-y-6">
            
            <!-- Metadata Gedung & Tanggal -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 bg-slate-50 rounded-lg border border-slate-200">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Gedung Arsip *</label>
                <select id="inputGedungSelect" required class="w-full text-xs p-2 rounded border border-slate-300 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
                  <option value="Pusat">Gedung Arsip Pusat</option>
                  <option value="Barat">Gedung Arsip Barat</option>
                  <option value="Timur">Gedung Arsip Timur</option>
                  <option value="Selatan">Gedung Arsip Selatan</option>
                  <option value="Utara">Gedung Arsip Utara</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Bulan & Tahun Pembaruan *</label>
                <input type="month" id="inputBulanTahun" value="2026-11" required class="w-full text-xs p-2 rounded border border-slate-300 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Petugas Penginput *</label>
                <input type="text" id="inputNamaPetugas" placeholder="Nama Petugas Arsip" value="Ahmad Subagyo" required class="w-full text-xs p-2 rounded border border-slate-300 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
              </div>
            </div>

            <!-- Input Capaian KPI Utama -->
            <div>
              <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-3">1. Capaian KPI Kearsipan Bulan Ini</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">1. Pengelolaan Arsip Aktif (%) [Target: &ge;95%]</label>
                  <input type="number" id="inputKpiAktif" min="0" max="100" value="95" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">2. Pengelolaan Arsip Inaktif (%) [Target: &ge;95%]</label>
                  <input type="number" id="inputKpiInaktif" min="0" max="100" value="94" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">3. Layanan Peminjaman Arsip (%) [Target: &ge;95%]</label>
                  <input type="number" id="inputKpiPinjam" min="0" max="100" value="98" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">4. Pengembalian Arsip (%) [Target: &ge;98%]</label>
                  <input type="number" id="inputKpiKembali" min="0" max="100" value="98" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">5. Pemindahan Arsip (%) [Target: &ge;95%]</label>
                  <input type="number" id="inputKpiPindah" min="0" max="100" value="96" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">6. Pemberkasan Arsip (%) [Target: &ge;95%]</label>
                  <input type="number" id="inputKpiBerkas" min="0" max="100" value="95" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">7. Usul Serah & Usul Musnah (%) [Target: 100%]</label>
                  <input type="number" id="inputKpiUsulMusnah" min="0" max="100" value="100" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
                <div class="p-3 bg-white border border-slate-200 rounded-lg space-y-2">
                  <label class="block text-xs font-medium text-slate-700">8. Pemeliharaan Arsip (%) [Target: &ge;95%]</label>
                  <input type="number" id="inputKpiPelihara" min="0" max="100" value="96" required class="w-full text-xs p-2 rounded border border-slate-300">
                </div>
              </div>
            </div>

            <!-- Bukti Pendukung / Tautan Google Drive -->
            <div class="p-4 bg-slate-50 rounded-lg border border-slate-200 space-y-2">
              <label class="block text-xs font-semibold text-slate-700">Tautan / Link Bukti Pendukung (Google Drive / Berita Acara) *</label>
              <input type="url" id="inputLinkBukti" placeholder="https://drive.google.com/drive/folders/..." value="https://drive.google.com/drive/folders/arsip-bbws-cc-2026" required class="w-full text-xs p-2.5 rounded border border-slate-300 bg-white">
              <p class="text-[11px] text-slate-500">Tautan ini diperiksa oleh Admin Kearsipan saat tahap Validasi & Monitoring.</p>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-end gap-3 pt-3">
              <button type="reset" class="px-4 py-2 border border-slate-300 text-slate-600 rounded-lg text-xs font-medium hover:bg-slate-100 transition">
                Reset Form
              </button>
              <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition shadow">
                <i class="fa-solid fa-floppy-disk"></i> Simpan ke Database Pusat
              </button>
            </div>

          </form>
        </div>
      </section>

      <!-- ================= TAB 6: LAPORAN & TINDAK LANJUT ================= -->
      <section id="tab-laporan" class="tab-content hidden space-y-6">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 pb-3 border-b border-slate-200">
            <div>
              <h3 class="text-base font-bold text-slate-800">Laporan Eksekutif & Lembar Evaluasi Pimpinan</h3>
              <p class="text-xs text-slate-500">Daftar gedung tepat waktu vs terlambat memperbarui data kearsipan</p>
            </div>
