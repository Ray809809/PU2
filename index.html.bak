      <!-- ================= TAB 3: STOK PENGELOLAAN ARSIP ================= -->
      <section id="tab-stok" class="tab-content hidden space-y-6">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 pb-3 border-b border-slate-200">
            <div>
              <h3 class="text-base font-bold text-slate-800">Data Stok Pengelolaan Arsip di Seluruh Gedung</h3>
              <p class="text-xs text-slate-500">Pencatatan arsip aktif, inaktif, vital, kondisi penyimpanan dan lokasi rak/ruang</p>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="openModalTambahStok()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-medium flex items-center gap-1.5 transition">
